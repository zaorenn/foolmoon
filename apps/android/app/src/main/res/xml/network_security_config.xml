<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext LAN / Tailscale connections to the user's own Foolmoon PC Gateway -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
